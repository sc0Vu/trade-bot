# Copy to deploy/.env (gitignored) and edit; docker compose reads it.
# Every value here is optional: unset means the default shown.

# Host ports for the stack's UIs (always bound to 127.0.0.1).
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
GRAFANA_PORT=3000

# Where Prometheus scrapes the bot: host:port of the bot's [metrics] listen
# (BOT_METRICS__LISTEN), as seen from inside Docker. Change the port here
# whenever you change it there.
TRADEBOT_METRICS_TARGET=host.docker.internal:9184
