{
  "uid": "trade-bot",
  "title": "trade-bot",
  "tags": [
    "trade-bot"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Feed age (s since last closed candle)",
      "description": "Alert fires above 150 s at 1m bars; the bot stops itself at 2 bars + 60 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - tradebot_last_candle_close_seconds",
          "legendFormat": "{{instrument}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Events / min",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(tradebot_events_total[5m]) * 60",
          "legendFormat": "events"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Orders and fills / hour",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instrument, side) (rate(tradebot_orders_submitted_total[1h])) * 3600",
          "legendFormat": "orders {{instrument}} {{side}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instrument, side) (rate(tradebot_fills_total[1h])) * 3600",
          "legendFormat": "fills {{instrument}} {{side}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rejected signals (15m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source, code) (increase(tradebot_signals_rejected_total[15m]))",
          "legendFormat": "{{source}} {{code}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Binance p99 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (path) (tradebot_binance_request_seconds{quantile=\"0.99\"})",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Binance errors (5m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (path, code) (increase(tradebot_binance_errors_total[5m]))",
          "legendFormat": "{{path}} {{code}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Open orders",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tradebot_open_orders",
          "legendFormat": "open"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Last close",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tradebot_last_close",
          "legendFormat": "{{instrument}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Position quantity (needs include_money)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tradebot_position_qty",
          "legendFormat": "{{instrument}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Realized P&L, quote (needs include_money)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tradebot_realized_pnl",
          "legendFormat": "{{instrument}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_resident_memory_bytes{job=\"trade-bot\"}",
          "legendFormat": "rss"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"trade-bot\"}[5m])",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Binance weight used (budget 4800 / min)",
      "description": "Rate limiter's count of request weight in the last minute; Binance's own report wins when higher.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tradebot_binance_weight_used",
          "legendFormat": "weight"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Rate limiter waits and 429s (15m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(tradebot_rate_limit_waits_total[15m])",
          "legendFormat": "waits"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(tradebot_binance_rate_limited_total[15m])",
          "legendFormat": "429/418"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Feed reconnects and backfilled bars (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(tradebot_feed_reconnects_total[1h])",
          "legendFormat": "reconnects"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(tradebot_feed_backfilled_total[1h])",
          "legendFormat": "backfilled bars"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Warnings and errors logged (5m)",
      "description": "From Loki: needs [log] file and the Alloy service.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({job=\"trade-bot\", level=~\"WARN|ERROR\"} | run=~\"$run\" [5m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Logs",
      "description": "From Loki. Order ids (o-1, o-2, …) restart every run; the run tag tells runs apart and prefixes the client order id on Binance (<tag>-o-2). Filter with the run box above.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 72
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"trade-bot\"} | run=~\"$run\""
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "run tag (regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Limits the log panels to one run, e.g. tbmvqk2hzs. .* = every run."
      }
    ]
  },
  "annotations": {
    "list": []
  }
}
